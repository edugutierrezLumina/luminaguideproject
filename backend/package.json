{
  "name": "luminaguide-backend",
  "version": "1.0.0",
  "description": "Backend API for LuminaGuide - Alternative Medicine Therapist Platform",
  "main": "dist/app.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/app.js",
    "start:dev": "cross-env NODE_ENV=development ts-node src/app.ts",
    "start:prod": "cross-env NODE_ENV=production node dist/app.js",
    "init-admin": "ts-node src/scripts/initAdmin.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "luminaguide",
    "alternative-medicine",
    "therapist",
    "api",
    "express",
    "mongodb"
  ],
  "author": "LuminaGuide Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
